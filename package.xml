<?xml version="1.0"?>
<package format="3">
	<name>uvdar_core</name>
	<version>2.0.0</version>
	<description>ROS 2 UVDAR core package</description>

	<maintainer email="vojtech.vrba@fel.cvut.cz">Vojtěch Vrba</maintainer>
	<license>BSD-3-Clause</license>

	<buildtool_depend>ament_cmake</buildtool_depend>
	<buildtool_depend>rosidl_default_generators</buildtool_depend>

	<depend>builtin_interfaces</depend>
	<depend>rclcpp</depend>
	<depend>sensor_msgs</depend>
	<depend>geometry_msgs</depend>
	<depend>tf2</depend>
	<depend>tf2_ros</depend>
	<depend>std_msgs</depend>
	<depend>std_srvs</depend>
	<depend>mrs_msgs</depend>
	<depend>mrs_modules_msgs</depend>
	<depend>cv_bridge</depend>
	<build_depend>yaml-cpp</build_depend>
	<exec_depend>yaml-cpp</exec_depend>

	<depend>launch</depend>
	<depend>launch_ros</depend>
	<exec_depend>glslang-tools</exec_depend>
	<exec_depend>mrs_serial</exec_depend>

	<exec_depend>rosidl_default_runtime</exec_depend>
	<test_depend>ament_cmake_gtest</test_depend>
	<member_of_group>rosidl_interface_packages</member_of_group>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
