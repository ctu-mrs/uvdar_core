#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define MAX_MARKERS 100

layout(push_constant) uniform Params {
    int threshold;
    int threshold_diff;
} pc;


layout(r8ui, set = 0, binding = 0) uniform readonly uimage2D image_input;
layout(r8ui, set = 0, binding = 1) uniform readonly uimage2D image_mask;
layout(std430, set = 0, binding = 2) buffer MarkerBuf { uvec2 marker_xy[]; } markers;
layout(std430, set = 0, binding = 3) buffer Counters { uint marker_count;} ctr;

#define FAST_RING_P3_SIZE 16
#define FAST_RING_INTERIOR_P3_SIZE 11

const ivec2 FAST_RING_P3[FAST_RING_P3_SIZE] = ivec2[](
    ivec2( 0, -3), ivec2( 0,  3), ivec2( 3,  0), ivec2(-3,  0),
    ivec2( 2, -2), ivec2(-2,  2), ivec2(-2, -2), ivec2( 2,  2),
    ivec2(-1, -3), ivec2( 1,  3), ivec2( 3, -1), ivec2(-3,  1),
    ivec2( 1, -3), ivec2(-1,  3), ivec2( 3,  1), ivec2(-3, -1)
);

const ivec2 FAST_INTERIOR_SET_P3[FAST_RING_INTERIOR_P3_SIZE] = ivec2[](
    ivec2( 0, 0), ivec2( 1, 0), ivec2( 2, 0),
    ivec2(-2, 1), ivec2(-1, 1),
    ivec2( 0, 1), ivec2( 1, 1), ivec2( 2, 1),
    ivec2(-1, 2),
    ivec2( 0, 2), ivec2( 1, 2)
);

/* testFastRing3px //{ */
bool testFastRing3px(ivec2 center_point, int center_val) {
    // N,S,E,W first
    for (int k = 0; k < 4; ++k) {
        int v = int(imageLoad(image_input, center_point + FAST_RING_P3[k]).r);
        if ((center_val - v) < pc.threshold_diff) return false;
    }
    // rest
    for (int k = 4; k < FAST_RING_P3_SIZE; ++k) {
        int v = int(imageLoad(image_input, center_point + FAST_RING_P3[k]).r);
        if ((center_val - v) < pc.threshold_diff) return false;
    }
    return true;
}
//}

/* recordMarker //{ */
void recordMarker(ivec2 point) {
    uint idx = atomicAdd(ctr.marker_count, 1u);
    if (idx < MAX_MARKERS) {
        markers.marker_xy[idx] = uvec2(point);
    }
}
//}

/* localizeMarkerPoint //{ */
void localizeMarkerPoint(ivec2 center_point){
    int best_val = 0;
    ivec2 best_point = center_point;

    for (int k=0; k<FAST_RING_INTERIOR_P3_SIZE; ++k){
        ivec2 q = center_point + FAST_INTERIOR_SET_P3[k];
        int s = int(imageLoad(image_input, q).r);

        if (s > best_val) {
            best_val = s;
            best_point = q;
        } 
    }
    recordMarker(best_point);
}
//}

/* isInsideRoi //{ */
bool isInsideRoi(ivec2 center_point, ivec2 image_size){
    if (center_point.x >= 4 && center_point.x < image_size.x-4 
        && center_point.y >= 4 && center_point.y < image_size.y-4 ) {
        return true;
    }
    return false;
}
//}



/* isBelowBrightnessThreshold //{ */
bool isBelowBrightnessThreshold(int center_brightness) {
    return center_brightness <= pc.threshold;
}
//}


bool isLocalMax3x3(ivec2 p, int v) {
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx) {
        if (dx == 0 && dy == 0) continue;
        int n = int(imageLoad(image_input, p + ivec2(dx, dy)).r);
        if (n >= v) return false;
    }
    return true;
}


/* main //{ */
void main()
{
    ivec2 center_point = ivec2(gl_GlobalInvocationID.xy);
    ivec2 image_size = imageSize(image_input);

    if (!isInsideRoi(center_point, image_size)) {
        return;
    }

    int center_brightness = int(imageLoad(image_input, center_point).r);
    if (isBelowBrightnessThreshold(center_brightness)) {
        return;
    }

    if (testFastRing3px(center_point, center_brightness)){
        recordMarker(center_point);
    }
}
